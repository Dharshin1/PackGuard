# PackGuard Backend Configuration
PORT=8000
HOST=0.0.0.0
CORS_ORIGINS=*

# MongoDB Connection (Optional - falls back to in-memory store if blank)
MONGODB_URI=mongodb://localhost:27017
DB_NAME=packguard

# Cloudinary Storage Configuration (Optional - falls back to local static uploads if blank)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
